    {
      "id": "hirei-001",
      "subunit": "関数と変域",
      "type": "choice",
      "question": "次のうち、y が x の関数であるものはどれか。",
      "choices": [
        "面積が x cm² の長方形のたての長さ y cm",
        "1辺が x cm の正方形の面積 y cm²",
        "身長が x cm の人の体重 y kg",
        "絶対値が x である数 y"
      ],
      "answer": "1辺が x cm の正方形の面積 y cm²",
      "explanation": "x の値を1つ決めると y の値がただ1つに決まるとき、y は x の関数。正方形の面積は1辺で1つに決まる。",
      "difficulty": 1,
      "tags": ["関数"]
    },
    {
      "id": "hirei-002",
      "subunit": "関数と変域",
      "type": "choice",
      "question": "「x の値が -2 より大きく 4 以下」を不等式で表したものはどれか。",
      "choices": [
