    {
      "id": "moji-001",
      "subunit": "文字式の表し方",
      "type": "choice",
      "question": "a×5 を文字式の表し方にしたがって表しなさい。",
      "choices": ["5a", "a5", "5×a", "a+5"],
      "answer": "5a",
      "explanation": "文字式では乗法の記号×を省略し、数は文字の前に書く。よってa×5=5a。",
      "difficulty": 1,
      "tags": ["表し方"]
    },
    {
      "id": "moji-002",
      "subunit": "文字式の表し方",
      "type": "choice",
      "question": "x×x×x を表しなさい。",
      "choices": ["3x", "x³", "x+3", "³x"],
      "answer": "x³",
      "explanation": "同じ文字の積は累乗の形で表す。x×x×x = x³。",
      "difficulty": 2,
      "tags": ["表し方", "累乗"]
    },
    {
      "id": "moji-003",
      "subunit": "文字式の表し方",
