      "question": "|-12| を計算しなさい。",
      "choices": null,
      "answer": "12",
      "explanation": "絶対値は符号を除いた数の大きさなので、|-12| = 12。",
      "difficulty": 1,
      "tags": ["絶対値"]
    },
