{
  "unit": "式の計算",
  "grade": 2,
  "questions": [
    {
      "id": "shiki2-001",
      "subunit": "単項式と多項式・次数",
      "type": "choice",
      "question": "次のうち、単項式であるものはどれか。",
      "choices": ["-3ab", "x+2", "2x-y", "a²+1"],
      "answer": "-3ab",
      "explanation": "数や文字のかけ算だけでできた式が単項式。-3abは単項式。ほかは和や差を含むので多項式。",
      "difficulty": 1,
      "tags": ["単項式"]
    },
    {
      "id": "shiki2-002",
      "subunit": "単項式と多項式・次数",
      "type": "choice",
      "question": "単項式 -5x²y の次数を求めよ。",
      "choices": ["3", "2", "5", "1"],
      "answer": "3",
      "explanation": "次数はかけ合わされている文字の個数。x²yはx×x×yで文字3個なので次数3。",
      "difficulty": 2,
      "tags": ["次数"]
    },
    {
      "id": "shiki2-003",
      "subunit": "単項式と多項式・次数",
      "type": "choice",
      "question": "多項式 2x²-3x+1 は何次式か。",
      "choices": ["2次式", "1次式", "3次式", "定数項"],
      "answer": "2次式",
      "explanation": "多項式の次数は各項の次数のうち最も大きいもの。2x²の次数2が最大なので2次式。",
      "difficulty": 2,
      "tags": ["次数", "多項式"]
    },
    {
      "id": "shiki2-004",
      "subunit": "多項式の加法と減法",
      "type": "choice",
      "question": "(3x+2y)+(x-5y) を計算せよ。",
      "choices": ["4x-3y", "4x+3y", "2x-3y", "4x-7y"],
      "answer": "4x-3y",
      "explanation": "同類項をまとめる。3x+x=4x、2y-5y=-3y。よって4x-3y。",
      "difficulty": 1,
      "tags": ["加法", "同類項"]
    },
    {
      "id": "shiki2-005",
      "subunit": "多項式の加法と減法",
      "type": "choice",
      "question": "(2a²-3a+1)+(a²+4a-6) を計算せよ。",
      "choices": ["3a²+a-5", "3a²-a-5", "3a²+a+5", "2a²+a-5"],
      "answer": "3a²+a-5",
      "explanation": "同類項をまとめる。2a²+a²=3a²、-3a+4a=a、1-6=-5。よって3a²+a-5。",
      "difficulty": 2,
      "tags": ["加法", "同類項"]
    },
    {
      "id": "shiki2-006",
      "subunit": "多項式の加法と減法",
      "type": "choice",
      "question": "(5x-3y)-(2x-7y) を計算せよ。",
      "choices": ["3x+4y", "3x-4y", "7x+4y", "3x-10y"],
      "answer": "3x+4y",
      "explanation": "かっこを外すと符号が変わる。5x-3y-2x+7y=3x+4y。",
      "difficulty": 2,
      "tags": ["減法"]
    },
    {
      "id": "shiki2-007",
      "subunit": "多項式の加法と減法",
      "type": "choice",
      "question": "(4a-2b)-(a+3b) を計算せよ。",
      "choices": ["3a-5b", "3a+b", "5a-5b", "3a+5b"],
      "answer": "3a-5b",
      "explanation": "かっこを外すと 4a-2b-a-3b=3a-5b。",
      "difficulty": 2,
      "tags": ["減法"]
    },
    {
      "id": "shiki2-008",
      "subunit": "多項式と数の乗除",
      "type": "choice",
      "question": "3(2x-4y) を計算せよ。",
      "choices": ["6x-12y", "6x-4y", "5x-12y", "6x+12y"],
      "answer": "6x-12y",
      "explanation": "分配法則で各項に3をかける。3×2x=6x、3×(-4y)=-12y。よって6x-12y。",
      "difficulty": 1,
      "tags": ["乗法", "分配法則"]
    },
    {
      "id": "shiki2-009",
      "subunit": "多項式と数の乗除",
      "type": "choice",
      "question": "-2(3a-5b) を計算せよ。",
      "choices": ["-6a+10b", "-6a-10b", "-6a+5b", "6a+10b"],
      "answer": "-6a+10b",
      "explanation": "-2を各項にかける。-2×3a=-6a、-2×(-5b)=10b。よって-6a+10b。",
      "difficulty": 2,
      "tags": ["乗法", "分配法則"]
    },
    {
      "id": "shiki2-010",
      "subunit": "多項式と数の乗除",
      "type": "choice",
      "question": "(8x-12y)÷4 を計算せよ。",
      "choices": ["2x-3y", "2x-12y", "2x-3", "4x-3y"],
      "answer": "2x-3y",
      "explanation": "各項を4でわる。8x÷4=2x、-12y÷4=-3y。よって2x-3y。",
      "difficulty": 2,
      "tags": ["除法"]
    },
    {
      "id": "shiki2-011",
      "subunit": "多項式と数の乗除",
      "type": "choice",
      "question": "2(3x-y)+3(x+2y) を計算せよ。",
      "choices": ["9x+4y", "9x-4y", "5x+4y", "9x+8y"],
      "answer": "9x+4y",
      "explanation": "かっこを外すと 6x-2y+3x+6y。同類項をまとめて 9x+4y。",
      "difficulty": 3,
      "tags": ["分配法則", "同類項"]
    },
    {
      "id": "shiki2-012",
      "subunit": "多項式と数の乗除",
      "type": "choice",
      "question": "3(2a-b)-2(a-3b) を計算せよ。",
      "choices": ["4a+3b", "4a-3b", "4a+9b", "8a+3b"],
      "answer": "4a+3b",
      "explanation": "かっこを外すと 6a-3b-2a+6b。同類項をまとめて 4a+3b。",
      "difficulty": 3,
      "tags": ["分配法則", "同類項"]
    },
    {
      "id": "shiki2-013",
      "subunit": "単項式の乗法と除法",
      "type": "choice",
      "question": "3x × 4y を計算せよ。",
      "choices": ["12xy", "7xy", "12x+y", "12xy²"],
      "answer": "12xy",
      "explanation": "係数どうし、文字どうしをかける。3×4=12、x×y=xy。よって12xy。",
      "difficulty": 1,
      "tags": ["単項式の乗法"]
    },
    {
      "id": "shiki2-014",
      "subunit": "単項式の乗法と除法",
      "type": "choice",
      "question": "2a × (-5a) を計算せよ。",
      "choices": ["-10a²", "-10a", "10a²", "-3a²"],
      "answer": "-10a²",
      "explanation": "2×(-5)=-10、a×a=a²。よって-10a²。",
      "difficulty": 2,
      "tags": ["単項式の乗法"]
    },
    {
      "id": "shiki2-015",
      "subunit": "単項式の乗法と除法",
      "type": "choice",
      "question": "(-3x)² を計算せよ。",
      "choices": ["9x²", "-9x²", "6x²", "-6x²"],
      "answer": "9x²",
      "explanation": "(-3x)²=(-3x)×(-3x)=9x²。符号は負×負で正になる。",
      "difficulty": 2,
      "tags": ["累乗"]
    },
    {
      "id": "shiki2-016",
      "subunit": "単項式の乗法と除法",
      "type": "choice",
      "question": "2x × 3x² を計算せよ。",
      "choices": ["6x³", "6x²", "5x³", "6x"],
      "answer": "6x³",
      "explanation": "2×3=6、x×x²=x³。よって6x³。",
      "difficulty": 2,
      "tags": ["単項式の乗法", "累乗"]
    },
    {
      "id": "shiki2-017",
      "subunit": "単項式の乗法と除法",
      "type": "choice",
      "question": "12a² ÷ 3a を計算せよ。",
      "choices": ["4a", "4a²", "4", "9a"],
      "answer": "4a",
      "explanation": "12a²÷3a=(12÷3)×(a²÷a)=4a。",
      "difficulty": 2,
      "tags": ["単項式の除法"]
    },
    {
      "id": "shiki2-018",
      "subunit": "単項式の乗法と除法",
      "type": "choice",
      "question": "15x²y ÷ 5x を計算せよ。",
      "choices": ["3xy", "3x", "3xy²", "10xy"],
      "answer": "3xy",
      "explanation": "15÷5=3、x²÷x=x、yはそのまま。よって3xy。",
      "difficulty": 3,
      "tags": ["単項式の除法"]
    },
    {
      "id": "shiki2-019",
      "subunit": "単項式の乗法と除法",
      "type": "choice",
      "question": "6a²b ÷ 2a × 3b を計算せよ。",
      "choices": ["9ab²", "9ab", "9a²b", "ab²"],
      "answer": "9ab²",
      "explanation": "左から順に。6a²b÷2a=3ab、3ab×3b=9ab²。",
      "difficulty": 3,
      "tags": ["乗除混合"]
    },
    {
      "id": "shiki2-020",
      "subunit": "式の値",
      "type": "numeric",
      "question": "x=3、y=-2 のとき、2x+3y の値を求めよ。",
      "choices": null,
      "answer": "0",
      "explanation": "2×3+3×(-2)=6-6=0。",
      "difficulty": 1,
      "tags": ["式の値", "代入"]
    },
    {
      "id": "shiki2-021",
      "subunit": "式の値",
      "type": "numeric",
      "question": "a=-2 のとき、a²-3a の値を求めよ。",
      "choices": null,
      "answer": "10",
      "explanation": "(-2)²-3×(-2)=4+6=10。",
      "difficulty": 2,
      "tags": ["式の値", "代入"]
    },
    {
      "id": "shiki2-022",
      "subunit": "式の値",
      "type": "numeric",
      "question": "x=4 のとき、3(2x-1)-2(x+3) の値を求めよ。まず式を簡単にしてから代入するとよい。",
      "choices": null,
      "answer": "7",
      "explanation": "3(2x-1)-2(x+3)=6x-3-2x-6=4x-9。x=4を代入して4×4-9=7。",
      "difficulty": 3,
      "tags": ["式の値", "式を簡単にする"]
    },
    {
      "id": "shiki2-023",
      "subunit": "文字式による説明",
      "type": "choice",
      "question": "連続する3つの整数を n-1, n, n+1 とするとき、その和を表す式はどれか。",
      "choices": ["3n", "3n+1", "3n-1", "n³"],
      "answer": "3n",
      "explanation": "(n-1)+n+(n+1)=3n。3の倍数であることが説明できる。",
      "difficulty": 2,
      "tags": ["文字式による説明"]
    },
    {
      "id": "shiki2-024",
      "subunit": "文字式による説明",
      "type": "choice",
      "question": "m を整数とするとき、偶数を表す式はどれか。",
      "choices": ["2m", "2m+1", "m+2", "m²"],
      "answer": "2m",
      "explanation": "偶数は2の倍数なので2×(整数)=2mと表せる。2m+1は奇数を表す。",
      "difficulty": 2,
      "tags": ["文字式による説明", "偶数奇数"]
    },
    {
      "id": "shiki2-025",
      "subunit": "等式の変形",
      "type": "choice",
      "question": "L=2(a+b) を b について解いた式はどれか。",
      "choices": ["b={{L}}/{{2}}-a", "b=L-a", "b={{L}}/{{2}}+a", "b=2L-a"],
      "answer": "b={{L}}/{{2}}-a",
      "explanation": "両辺を2でわると {{L}}/{{2}}=a+b。a を移項して b={{L}}/{{2}}-a。",
      "difficulty": 3,
      "tags": ["等式の変形"]
    },
    {
      "id": "shiki2-026",
      "subunit": "等式の変形",
      "type": "choice",
      "question": "3x+2y=6 を y について解いた式はどれか。",
      "choices": ["y={{6-3x}}/{{2}}", "y=6-3x", "y={{6-3x}}/{{3}}", "y=3-3x"],
      "answer": "y={{6-3x}}/{{2}}",
      "explanation": "3xを移項して2y=6-3x。両辺を2でわって y={{6-3x}}/{{2}}。",
      "difficulty": 3,
      "tags": ["等式の変形"]
    }
  ]
}
