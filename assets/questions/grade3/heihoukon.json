    {
      "id": "heihoukon-001",
      "subunit": "平方根の意味",
      "type": "choice",
      "question": "25の平方根をすべて答えなさい。",
      "choices": ["5と-5", "5", "-5", "√5"],
      "answer": "5と-5",
      "explanation": "2乗して25になる数が25の平方根。5²=25、(-5)²=25 なので、平方根は5と-5の2つ。",
      "difficulty": 1,
      "tags": ["平方根", "平方根の意味"]
    },
    {
      "id": "heihoukon-002",
      "subunit": "平方根の意味",
      "type": "choice",
      "question": "7の平方根を根号を使って表しなさい。",
      "choices": ["±√7", "√7", "±7", "√14"],
      "answer": "±√7",
      "explanation": "7の平方根は2乗して7になる数で、正のほうが√7、負のほうが-√7。まとめて±√7と表す。",
      "difficulty": 1,
      "tags": ["平方根", "平方根の意味", "根号"]
    },
