{
  "unit": "展開と因数分解",
  "grade": 3,
  "questions": [
    {
      "id": "tenkai-001",
      "subunit": "単項式と多項式の乗除",
      "type": "choice",
      "question": "次の式を計算せよ。 3x(x+2)",
      "choices": ["3x²+6x", "3x²+2x", "3x²+6", "x²+6x"],
      "answer": "3x²+6x",
      "explanation": "分配法則でかっこの中の各項に3xをかける。3x×x=3x²、3x×2=6xなので 3x²+6x。",
      "difficulty": 1,
      "tags": ["分配法則", "単項式×多項式"]
    },
    {
      "id": "tenkai-002",
      "subunit": "単項式と多項式の乗除",
      "type": "choice",
      "question": "次の式を計算せよ。 -2a(3a-5)",
      "choices": ["-6a²+10a", "-6a²-10a", "6a²-10a", "-6a²+10"],
      "answer": "-6a²+10a",
      "explanation": "-2a×3a=-6a²、-2a×(-5)=10a。符号に注意して -6a²+10a。",
      "difficulty": 1,
      "tags": ["分配法則", "符号"]
    },
    {
      "id": "tenkai-003",
      "subunit": "単項式と多項式の乗除",
      "type": "choice",
      "question": "次の式を計算せよ。 (6x²+4x)÷2x",
      "choices": ["3x+2", "3x+4", "3x²+2", "3x-2"],
      "answer": "3x+2",
      "explanation": "各項を2xで割る。6x²÷2x=3x、4x÷2x=2。よって 3x+2。",
      "difficulty": 1,
      "tags": ["多項式÷単項式"]
    },
    {
      "id": "tenkai-004",
      "subunit": "単項式と多項式の乗除",
      "type": "choice",
      "question": "次の式を計算せよ。 (8a²b-12ab²)÷4ab",
      "choices": ["2a-3b", "2a+3b", "2a²-3b²", "4a-3b"],
      "answer": "2a-3b",
      "explanation": "各項を4abで割る。8a²b÷4ab=2a、-12ab²÷4ab=-3b。よって 2a-3b。",
      "difficulty": 1,
      "tags": ["多項式÷単項式"]
    },
    {
      "id": "tenkai-005",
      "subunit": "(x+a)(x+b)の展開",
      "type": "choice",
      "question": "次の式を展開せよ。 (x+2)(x+3)",
      "choices": ["x²+5x+6", "x²+6x+5", "x²+5x+5", "x²+6x+6"],
      "answer": "x²+5x+6",
      "explanation": "(x+a)(x+b)=x²+(a+b)x+ab。和2+3=5がxの係数、積2×3=6が定数項。x²+5x+6。",
      "difficulty": 1,
      "tags": ["展開", "(x+a)(x+b)"]
    },
    {
      "id": "tenkai-006",
      "subunit": "(x+a)(x+b)の展開",
      "type": "choice",
      "question": "次の式を展開せよ。 (x+4)(x-2)",
      "choices": ["x²+2x-8", "x²-2x-8", "x²+2x+8", "x²+6x-8"],
      "answer": "x²+2x-8",
      "explanation": "和4+(-2)=2、積4×(-2)=-8。よって x²+2x-8。",
      "difficulty": 1,
      "tags": ["展開", "符号"]
    },
    {
      "id": "tenkai-007",
      "subunit": "(x+a)(x+b)の展開",
      "type": "choice",
      "question": "次の式を展開せよ。 (x-5)(x+3)",
      "choices": ["x²-2x-15", "x²+2x-15", "x²-2x+15", "x²-8x-15"],
      "answer": "x²-2x-15",
      "explanation": "和(-5)+3=-2、積(-5)×3=-15。よって x²-2x-15。",
      "difficulty": 2,
      "tags": ["展開", "符号"]
    },
    {
      "id": "tenkai-008",
      "subunit": "(x+a)(x+b)の展開",
      "type": "choice",
      "question": "次の式を展開せよ。 (x-4)(x-6)",
      "choices": ["x²-10x+24", "x²+10x+24", "x²-10x-24", "x²-24x+10"],
      "answer": "x²-10x+24",
      "explanation": "和(-4)+(-6)=-10、積(-4)×(-6)=24。負×負は正なので x²-10x+24。",
      "difficulty": 2,
      "tags": ["展開", "符号"]
    },
    {
      "id": "tenkai-009",
      "subunit": "乗法公式((a+b)², (a-b)², (a+b)(a-b))",
      "type": "choice",
      "question": "次の式を展開せよ。 (x+5)²",
      "choices": ["x²+10x+25", "x²+25", "x²+5x+25", "x²+10x+10"],
      "answer": "x²+10x+25",
      "explanation": "(a+b)²=a²+2ab+b²。真ん中の項は2×x×5=10x。x²+10x+25。x²+25としないよう注意。",
      "difficulty": 2,
      "tags": ["乗法公式", "平方"]
    },
    {
      "id": "tenkai-010",
      "subunit": "乗法公式((a+b)², (a-b)², (a+b)(a-b))",
      "type": "choice",
      "question": "次の式を展開せよ。 (x-7)²",
      "choices": ["x²-14x+49", "x²-49", "x²+14x+49", "x²-14x-49"],
      "answer": "x²-14x+49",
      "explanation": "(a-b)²=a²-2ab+b²。真ん中は-2×x×7=-14x、最後は(-7)²=49。x²-14x+49。",
      "difficulty": 2,
      "tags": ["乗法公式", "平方"]
    },
    {
      "id": "tenkai-011",
      "subunit": "乗法公式((a+b)², (a-b)², (a+b)(a-b))",
      "type": "choice",
      "question": "次の式を展開せよ。 (x+6)(x-6)",
      "choices": ["x²-36", "x²+36", "x²-12x-36", "x²-6"],
      "answer": "x²-36",
      "explanation": "(a+b)(a-b)=a²-b²(和と差の積)。x²-6²=x²-36。xの項は消える。",
      "difficulty": 2,
      "tags": ["乗法公式", "和と差の積"]
    },
    {
      "id": "tenkai-012",
      "subunit": "乗法公式((a+b)², (a-b)², (a+b)(a-b))",
      "type": "choice",
      "question": "次の式を展開せよ。 (2x+3)²",
      "choices": ["4x²+12x+9", "4x²+9", "2x²+12x+9", "4x²+6x+9"],
      "answer": "4x²+12x+9",
      "explanation": "(2x)²=4x²、2×2x×3=12x、3²=9。よって 4x²+12x+9。",
      "difficulty": 2,
      "tags": ["乗法公式", "係数つき"]
    },
    {
      "id": "tenkai-013",
      "subunit": "乗法公式((a+b)², (a-b)², (a+b)(a-b))",
      "type": "choice",
      "question": "次の式を展開せよ。 (3a-2b)(3a+2b)",
      "choices": ["9a²-4b²", "9a²+4b²", "3a²-2b²", "9a²-12ab+4b²"],
      "answer": "9a²-4b²",
      "explanation": "和と差の積なので (3a)²-(2b)²=9a²-4b²。",
      "difficulty": 2,
      "tags": ["乗法公式", "和と差の積"]
    },
    {
      "id": "tenkai-014",
      "subunit": "共通因数でくくる",
      "type": "choice",
      "question": "次の式を因数分解せよ。 4x²+8x",
      "choices": ["4x(x+2)", "4x(x+4)", "2x(x+4)", "4x(x-2)"],
      "answer": "4x(x+2)",
      "explanation": "共通因数は4x。4x²=4x×x、8x=4x×2なので 4x(x+2)。展開して確かめるとよい。",
      "difficulty": 2,
      "tags": ["因数分解", "共通因数"]
    },
    {
      "id": "tenkai-015",
      "subunit": "共通因数でくくる",
      "type": "choice",
      "question": "次の式を因数分解せよ。 6a²b-9ab²",
      "choices": ["3ab(2a-3b)", "3ab(2a+3b)", "3ab(3a-2b)", "6ab(a-3b)"],
      "answer": "3ab(2a-3b)",
      "explanation": "係数の最大公約数3と共通の文字abをくくり出す。6a²b=3ab×2a、-9ab²=3ab×(-3b)。3ab(2a-3b)。",
      "difficulty": 2,
      "tags": ["因数分解", "共通因数"]
    },
    {
      "id": "tenkai-016",
      "subunit": "共通因数でくくる",
      "type": "choice",
      "question": "次の式を因数分解せよ。 2x²y+4xy²-6xy",
      "choices": ["2xy(x+2y-3)", "2xy(x+2y+3)", "2xy(x+4y-6)", "2xy(2x+2y-3)"],
      "answer": "2xy(x+2y-3)",
      "explanation": "3つの項の共通因数は2xy。それぞれ2xyで割ると x、2y、-3。よって 2xy(x+2y-3)。",
      "difficulty": 2,
      "tags": ["因数分解", "共通因数"]
    },
    {
      "id": "tenkai-017",
      "subunit": "公式を使う因数分解",
      "type": "choice",
      "question": "次の式を因数分解せよ。 x²+7x+12",
      "choices": ["(x+3)(x+4)", "(x+2)(x+6)", "(x-3)(x-4)", "(x+2)(x+5)"],
      "answer": "(x+3)(x+4)",
      "explanation": "積が12、和が7になる2数は3と4。よって (x+3)(x+4)。",
      "difficulty": 2,
      "tags": ["因数分解", "x²+(a+b)x+ab"]
    },
    {
      "id": "tenkai-018",
      "subunit": "公式を使う因数分解",
      "type": "choice",
      "question": "次の式を因数分解せよ。 x²-x-20",
      "choices": ["(x+4)(x-5)", "(x-4)(x+5)", "(x+2)(x-10)", "(x-4)(x-5)"],
      "answer": "(x+4)(x-5)",
      "explanation": "積が-20、和が-1になる2数は4と-5。よって (x+4)(x-5)。符号の組み合わせに注意。",
      "difficulty": 2,
      "tags": ["因数分解", "符号"]
    },
    {
      "id": "tenkai-019",
      "subunit": "公式を使う因数分解",
      "type": "choice",
      "question": "次の式を因数分解せよ。 x²+8x+16",
      "choices": ["(x+4)²", "(x+8)²", "(x-4)²", "(x+4)(x-4)"],
      "answer": "(x+4)²",
      "explanation": "16=4²、8x=2×x×4なので a²+2ab+b²=(a+b)²の形。(x+4)²。",
      "difficulty": 2,
      "tags": ["因数分解", "平方の公式"]
    },
    {
      "id": "tenkai-020",
      "subunit": "公式を使う因数分解",
      "type": "choice",
      "question": "次の式を因数分解せよ。 x²-12x+36",
      "choices": ["(x-6)²", "(x+6)²", "(x-6)(x+6)", "(x-12)²"],
      "answer": "(x-6)²",
      "explanation": "36=6²、-12x=-2×x×6なので a²-2ab+b²=(a-b)²の形。(x-6)²。",
      "difficulty": 2,
      "tags": ["因数分解", "平方の公式"]
    },
    {
      "id": "tenkai-021",
      "subunit": "公式を使う因数分解",
      "type": "choice",
      "question": "次の式を因数分解せよ。 x²-49",
      "choices": ["(x+7)(x-7)", "(x-7)²", "(x+7)²", "(x+49)(x-1)"],
      "answer": "(x+7)(x-7)",
      "explanation": "a²-b²=(a+b)(a-b)。x²-7²=(x+7)(x-7)。",
      "difficulty": 2,
      "tags": ["因数分解", "2乗の差"]
    },
    {
      "id": "tenkai-022",
      "subunit": "公式を使う因数分解",
      "type": "choice",
      "question": "次の式を因数分解せよ。 2x²-18",
      "choices": ["2(x+3)(x-3)", "(x+3)(x-3)", "2(x-3)²", "2(x+9)(x-9)"],
      "answer": "2(x+3)(x-3)",
      "explanation": "まず共通因数2でくくって 2(x²-9)。さらに x²-9=(x+3)(x-3) なので 2(x+3)(x-3)。",
      "difficulty": 3,
      "tags": ["因数分解", "共通因数と公式の組み合わせ"]
    },
    {
      "id": "tenkai-023",
      "subunit": "公式を使う因数分解",
      "type": "choice",
      "question": "次の式を因数分解せよ。 9x²-30x+25",
      "choices": ["(3x-5)²", "(3x+5)²", "(3x-5)(3x+5)", "(9x-5)²"],
      "answer": "(3x-5)²",
      "explanation": "9x²=(3x)²、25=5²、-30x=-2×3x×5 なので (3x-5)²。",
      "difficulty": 3,
      "tags": ["因数分解", "係数つき平方"]
    },
    {
      "id": "tenkai-024",
      "subunit": "因数分解・展開の利用(計算の工夫)",
      "type": "numeric",
      "question": "乗法公式を使って工夫して計算せよ。 101²",
