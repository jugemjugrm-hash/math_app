      "tags": ["計算の工夫", "展開の利用"]
    },
    {
      "id": "tenkai-025",
      "subunit": "因数分解・展開の利用(計算の工夫)",
      "type": "numeric",
      "question": "乗法公式を使って工夫して計算せよ。 98²",
      "choices": null,
      "answer": "9604",
      "explanation": "98=100-2とみて (100-2)²=10000-400+4=9604。",
      "difficulty": 3,
      "tags": ["計算の工夫", "展開の利用"]
    },
    {
      "id": "tenkai-026",
      "subunit": "因数分解・展開の利用(計算の工夫)",
      "type": "numeric",
      "question": "乗法公式を使って工夫して計算せよ。 103×97",
      "choices": null,
      "answer": "9991",
      "explanation": "(100+3)(100-3)=100²-3²=10000-9=9991。和と差の積の公式を利用。",
      "difficulty": 3,
      "tags": ["計算の工夫", "和と差の積"]
    },
    {
      "id": "tenkai-027",
      "subunit": "因数分解・展開の利用(計算の工夫)",
      "type": "numeric",
      "question": "因数分解を使って工夫して計算せよ。 57²-43²",
      "choices": null,
      "answer": "1400",
      "explanation": "a²-b²=(a+b)(a-b)より (57+43)(57-43)=100×14=1400。",
      "difficulty": 3,
      "tags": ["計算の工夫", "因数分解の利用"]
    },
    {
      "id": "tenkai-028",
      "subunit": "因数分解・展開の利用(計算の工夫)",
      "type": "numeric",
      "question": "x=27 のとき、x²-14x+49 の値を求めよ。",
      "choices": null,
      "answer": "400",
      "explanation": "先に因数分解して (x-7)²。x=27を代入すると (27-7)²=20²=400。",
      "difficulty": 3,
      "tags": ["式の値", "因数分解の利用"]
    }
  ]
